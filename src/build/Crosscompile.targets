<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <AotPreferCustom>true</AotPreferCustom>
    <PublishAotCrossDebug Condition="'$(PublishAotCrossDebug)' == ''">true</PublishAotCrossDebug>
    <HostRuntimeIdentifier Condition="'$(HostRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</HostRuntimeIdentifier>
    <UseExternalZig Condition="'$(UseExternalZig)' == ''">false</UseExternalZig>
    <GlibcVersion Condition="'$(GlibcVersion)' == ''" />

    <!-- macOS SDK root for cross-compiling to osx. Set via the MacOSXSDKDir
         property (e.g. supplied by the MacOSX.SDK package) or the MACOSX_SDK
         environment variable; the clang wrapper consumes it as MACOSX_SDK. -->
    <MacOSXSDKDir Condition="'$(MacOSXSDKDir)' == ''">$(MACOSX_SDK)</MacOSXSDKDir>

    <!-- When cross-compiling to macOS from a non-macOS host, ILCompiler would
         invoke the macOS-only `dsymutil`/`strip` tools, which Windows/Linux lack.
         Default symbol stripping off in that case (users can override). -->
    <_IsCrossCompilingToMacOS Condition="$(RuntimeIdentifier.StartsWith('osx')) and !$(HostRuntimeIdentifier.StartsWith('osx'))">true</_IsCrossCompilingToMacOS>
    <StripSymbols Condition="'$(StripSymbols)' == '' and '$(_IsCrossCompilingToMacOS)' == 'true'">false</StripSymbols>
  </PropertyGroup>

  <UsingTask TaskName="PrependPathIfCrossCompile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <MSBuildThisFileDirectory ParameterType="System.String" Required="true" />
      <RuntimeIdentifier ParameterType="System.String" Required="true" />
      <ZigPath ParameterType="System.String" Required="true" />
      <AotPreferCustom ParameterType="System.Boolean" Required="true" />
      <UseExternalZig ParameterType="System.Boolean" Required="true" />
      <MacOSXSDKDir ParameterType="System.String" Required="false" />
      <PublishAotCrossDebug ParameterType="System.Boolean" Required="false" />
      <!-- Out Variables -->
      <CustomAotToolChain ParameterType="System.String" Output="true"/>
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Runtime.InteropServices" />

      <Code Type="Fragment" Language="cs" Source="$(MSBuildThisFileDirectory)/Scripts/SetPath.cs">
      </Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="GetSwiftAutolinkArgs"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <NativeLibraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <MacOSXSDKDir ParameterType="System.String" Required="false" />
      <PublishAotCrossDebug ParameterType="System.Boolean" Required="false" />
      <!-- Out Variables -->
      <LinkerArgs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs" Source="$(MSBuildThisFileDirectory)/Scripts/GetSwiftAutolinkArgs.cs">
      </Code>
    </Task>
  </UsingTask>

  <Target
    Name="SetPathToClang"
    BeforeTargets="SetupOSSpecificProps">
    <PropertyGroup Condition="$(HostRuntimeIdentifier.StartsWith('win-'))">
      <ZigPath Condition="$(HostRuntimeIdentifier.EndsWith('-x64'))">$(PkgVezel_Zig_Toolsets_win-x64)/tools</ZigPath>
      <ZigPath Condition="$(HostRuntimeIdentifier.EndsWith('-arm64'))">$(PkgVezel_Zig_Toolsets_win-arm64)/tools</ZigPath>
    </PropertyGroup>

    <PropertyGroup Condition="$(HostRuntimeIdentifier.StartsWith('linux-'))">
      <ZigPath Condition="$(HostRuntimeIdentifier.EndsWith('-x64'))">$(PkgVezel_Zig_Toolsets_linux-x64)/tools</ZigPath>
      <ZigPath Condition="$(HostRuntimeIdentifier.EndsWith('-arm64'))">$(PkgVezel_Zig_Toolsets_linux-arm64)/tools</ZigPath>
    </PropertyGroup>

    <PropertyGroup Condition="$(HostRuntimeIdentifier.StartsWith('osx-'))">
      <ZigPath Condition="$(HostRuntimeIdentifier.EndsWith('-x64'))">$(PkgVezel_Zig_Toolsets_osx-x64)/tools</ZigPath>
      <ZigPath Condition="$(HostRuntimeIdentifier.EndsWith('-arm64'))">$(PkgVezel_Zig_Toolsets_osx-arm64)/tools</ZigPath>
    </PropertyGroup>

    <PrependPathIfCrossCompile
      MSBuildThisFileDirectory="$(MSBuildThisFileDirectory)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      ZigPath="$(ZigPath)"
      AotPreferCustom="$(AotPreferCustom)"
      UseExternalZig="$(UseExternalZig)"
      MacOSXSDKDir="$(MacOSXSDKDir)"
      PublishAotCrossDebug="$(PublishAotCrossDebug)">
      <Output TaskParameter="CustomAotToolChain" PropertyName="CustomAotToolChain"/>
    </PrependPathIfCrossCompile>

    <PropertyGroup Condition="'$(CustomAotToolChain)' == 'xwin' and $(RuntimeIdentifier.StartsWith('win'))">
      <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    </PropertyGroup>
  </Target>

  <!-- BEGIN: Works around ILCompiler targets not detecting this as a cross compilation -->
  <Target Name="OverwriteTargetTriple"
          AfterTargets="SetupOSSpecificProps"
          BeforeTargets="LinkNative">

    <PropertyGroup Condition=" '$(CustomAotToolChain)' == 'zig' ">
      <CrossCompileRid />
      <CrossCompileRid>$(RuntimeIdentifier)</CrossCompileRid>

      <CrossCompileArch />
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-x64'))">x86_64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm64'))">aarch64</CrossCompileArch>

      <GlibcSuffix Condition="'$(GlibcVersion)' != ''">.$(GlibcVersion)</GlibcSuffix>

      <TargetTriple />
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('linux'))">$(CrossCompileArch)-linux-gnu$(GlibcSuffix)</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and ($(CrossCompileRid.StartsWith('linux-musl')) or $(CrossCompileRid.StartsWith('alpine')))">$(CrossCompileArch)-linux-musl</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('osx'))">$(CrossCompileArch)-macos</TargetTriple>

      <!-- macOS SDK sysroot for cross-compiling to osx (from the MacOSX.SDK package
           property MacOSXSDKDir, or the MACOSX_SDK environment variable). -->
      <_MacOSXSDKDir Condition="'$(_MacOSXSDKDir)' == ''">$(MacOSXSDKDir)</_MacOSXSDKDir>
      <_MacOSXSDKDir Condition="'$(_MacOSXSDKDir)' == ''">$(MACOSX_SDK)</_MacOSXSDKDir>
    </PropertyGroup>

    <ItemGroup Condition=" '$(CustomAotToolChain)' == 'zig' ">
      <LinkerArg Include="--target=$(TargetTriple)" />
      <LinkerArg Condition="'$(_MacOSXSDKDir)' != '' and $(RuntimeIdentifier.StartsWith('osx'))" Include="-isysroot $(_MacOSXSDKDir)" />
    </ItemGroup>

    <!-- macOS 目标：Apple Crypto 静态库 (libSystem.Security.Cryptography.Native.Apple.a)
         带有 Swift autolink 条目 (LC_LINKER_OPTION)，ld64 会自动展开成 -lswift*，
         但 Zig 链接器不解析这些条目，导致 __swift_FORCE_LOAD_$_swift* 变成未定义
         符号（任何走 TLS/X509 的库都会踩到，如 mysql/postgres/sqlserver）。
         这里不硬编码模块清单（会随 SDK/.NET 版本漂移漏项），而是扫描实际参与链接
         的原生静态库、重放其中的 Swift autolink；仅保留 macOS SDK 中确实存在的
         库/framework，并配合 -dead_strip_dylibs 剔除最终产物里未用到的依赖。 -->
    <GetSwiftAutolinkArgs
      Condition=" '$(CustomAotToolChain)' == 'zig' and $(RuntimeIdentifier.StartsWith('osx')) "
      NativeLibraries="@(NativeLibrary)"
      MacOSXSDKDir="$(_MacOSXSDKDir)"
      PublishAotCrossDebug="$(PublishAotCrossDebug)">
      <Output TaskParameter="LinkerArgs" ItemName="_SwiftAutolinkArgs" />
    </GetSwiftAutolinkArgs>

    <ItemGroup Condition=" '$(CustomAotToolChain)' == 'zig' and $(RuntimeIdentifier.StartsWith('osx')) ">
      <LinkerArg Include="-Wl,-dead_strip_dylibs" />
      <LinkerArg Include="@(_SwiftAutolinkArgs)" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(CustomAotToolChain)' == 'xwin' ">
      <CrossCompileRid />
      <CrossCompileRid>$(RuntimeIdentifier)</CrossCompileRid>

      <CrossCompileArch />
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-x64'))">x64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm64'))">arm64</CrossCompileArch>

      <XwinArches Condition="'$(XwinArches)' == ''">x86_64,aarch64</XwinArches>

      <CppLinker Condition="'$(HostRuntimeIdentifier)' == 'win-x64'">$(LLDLinkToolsetsWinX64Dir)lld-link.exe</CppLinker>
      <CppLinker Condition="'$(HostRuntimeIdentifier)' == 'win-arm64'">$(LLDLinkToolsetsWinArm64Dir)lld-link.exe</CppLinker>
      <CppLinker Condition="'$(HostRuntimeIdentifier)' == 'linux-x64'">$(LLDLinkToolsetsLinuxX64Dir)lld-link</CppLinker>
      <CppLinker Condition="'$(HostRuntimeIdentifier)' == 'linux-arm64'">$(LLDLinkToolsetsLinuxArm64Dir)lld-link</CppLinker>
      <CppLinker Condition="'$(HostRuntimeIdentifier)' == 'osx-arm64'">$(LLDLinkToolsetsOsxArm64Dir)lld-link</CppLinker>
      <CppLinker Condition="'$(CppLinker)' == ''">lld-link</CppLinker>
      <IlcUseEnvironmentalTools Condition="$(HostRuntimeIdentifier.StartsWith('win'))">true</IlcUseEnvironmentalTools>

      <_XWinStore Condition="'$(CrossCompileArch)' == 'arm64'">$(XWinStoreArm64Dir)</_XWinStore>
      <_XWinStore Condition="'$(CrossCompileArch)' != 'arm64'">$(XWinStoreX64Dir)</_XWinStore>
    </PropertyGroup>

    <PropertyGroup Condition="'$(CustomAotToolChain)' == 'xwin' and '$(_XWinStore)' == ''">
      <CustomAotToolChain />
    </PropertyGroup>

    <ItemGroup Condition=" '$(CustomAotToolChain)' == 'xwin' ">
      <_NoExpLinkerArg Include="@(LinkerArg->Replace('/NOEXP', ''))" />
      <_NoExpLinkerArg Remove="@(_NoExpLinkerArg)" Condition="$([System.String]::new('%(Identity)').StartsWith('/SOURCELINK:'))" />
      <LinkerArg Remove="@(LinkerArg)" />

      <LinkerArg Include="/vctoolsdir:$(_XWinStore)/splat/crt" />
      <LinkerArg Include="/winsdkdir:$(_XWinStore)/splat/sdk" />
      <LinkerArg Include="/LIBPATH:$(_XWinStore)/splat/sdk/lib/ucrt/$(CrossCompileArch)/" />
      <LinkerArg Include="/LIBPATH:$(_XWinStore)/splat/sdk/lib/um/$(CrossCompileArch)/" />
      <LinkerArg Include="/LIBPATH:$(_XWinStore)/splat/crt/lib/$(CrossCompileArch)/" />

      <LinkerArg Include="@(_NoExpLinkerArg)" />
    </ItemGroup>

  </Target>
  <!-- END: Works around ILCompiler targets not detecting this as a cross compilation -->

</Project>
