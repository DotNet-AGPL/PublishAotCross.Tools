<Project Sdk="Microsoft.Build.NoTargets">
  <Import Project="../toolsets/ToolsetsVersion.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>PublishAotCross.Tools</PackageId>
    <Version Condition="'$(Version)' == ''">0.6.0.$(Revision)</Version>
    <Authors>Michal Strehovsky;Fallenwood</Authors>
    <Company>DotNet-AGPL</Company>
    <Description>MSBuild targets to aid in crosscompiling Native AOT publishing.</Description>
    <PackageProjectUrl>https://github.com/DotNet-AGPL/PublishAotCross.Tools</PackageProjectUrl>
    <PackageLicenseExpression>MIT OR AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vezel.Zig.Toolsets.win-x64" Version="$(ZigVersion)" GeneratePathProperty="true" />
    <PackageReference Include="Vezel.Zig.Toolsets.win-arm64" Version="$(ZigVersion)" GeneratePathProperty="true" />
    <PackageReference Include="Vezel.Zig.Toolsets.linux-x64" Version="$(ZigVersion)" GeneratePathProperty="true" />
    <PackageReference Include="Vezel.Zig.Toolsets.linux-arm64" Version="$(ZigVersion)" GeneratePathProperty="true" />
    <PackageReference Include="Vezel.Zig.Toolsets.osx-x64" Version="$(ZigVersion)" GeneratePathProperty="true" />
    <PackageReference Include="Vezel.Zig.Toolsets.osx-arm64" Version="$(ZigVersion)" GeneratePathProperty="true" />
    <PackageReference Include="XWin.Store.x64" Version="$(XWinVersion).$(Revision)" />
    <PackageReference Include="XWin.Store.arm64" Version="$(XWinVersion).$(Revision)" />
    <PackageReference Include="LLD.Link.Toolsets.win-x64" Version="$(LLDVersion).$(Revision)" />
    <PackageReference Include="LLD.Link.Toolsets.linux-x64" Version="$(LLDVersion).$(Revision)" />
    <PackageReference Include="LLD.Link.Toolsets.win-arm64" Version="$(LLDVersion).$(Revision)" />
    <PackageReference Include="LLD.Link.Toolsets.linux-arm64" Version="$(LLDVersion).$(Revision)" />
    <PackageReference Include="LLD.Link.Toolsets.osx-arm64" Version="$(LLDVersion).$(Revision)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PublishAotCross.Tools.props">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="../toolsets/ToolsetsVersion.props" Link="ToolsetsVersion.props">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="PublishAotCross.Tools.targets">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="Crosscompile.targets">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="clang.cmd">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="clang.ps1">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="../README.md">
      <Pack>true</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="clang">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="gcc">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="objcopy">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="llvm-objcopy.exe">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="Scripts/SetPath.cs">
      <Pack>true</Pack>
      <PackagePath>build/Scripts/SetPath.cs</PackagePath>
    </None>
  </ItemGroup>
</Project>
