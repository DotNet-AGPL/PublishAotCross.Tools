<Project Sdk="Microsoft.Build.NoTargets">
  <Import Project="../../ToolsetsVersion.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>MacOSX.SymbolTools.linux-arm64</PackageId>
    <Version>$(LLDVersion).$(Revision)</Version>
    <Authors>LLVM Project;DotNet-AGPL</Authors>
    <Company>DotNet-AGPL</Company>
    <Description>LLVM dsymutil for the linux-arm64 host (stripped). Generates the .dSYM bundle when cross-compiling Native AOT to macOS from a non-macOS host (ld64 never emits DWARF into Mach-O).</Description>
    <PackageProjectUrl>https://github.com/DotNet-AGPL/PublishAotCross.Tools/tree/main/toolsets/MacOSX.SymbolTools/linux-arm64</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="tools/dsymutil" Pack="true" PackagePath="tools" />
    <None Include="build/MacOSX.SymbolTools.linux-arm64.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../../skills/publishaotcross-tools/**" Pack="true" PackagePath="skills/publishaotcross-tools/" />
  </ItemGroup>

  <Target Name="EnsureDsymutilPresent" BeforeTargets="Build">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/tools/dsymutil')"
           Text="tools/dsymutil is missing. Run 'toolsets/download-macosx-symbols.ps1 -Platform linux-arm64' first (it extracts and strips the binary from toolsets/LLVM-Source)." />
  </Target>
</Project>
