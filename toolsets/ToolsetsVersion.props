<Project>
  <PropertyGroup>
    <ZigVersion Condition="'$(ZigVersion)' == ''">0.17.0.1</ZigVersion>
    <XWinVersion Condition="'$(XWinVersion)' == ''">0.10.0</XWinVersion>
    <LLDVersion Condition="'$(LLDVersion)' == ''">23.1.3</LLDVersion>
    <MacOSXSDKVersion Condition="'$(MacOSXSDKVersion)' == ''">26.1</MacOSXSDKVersion>
    <Revision Condition="'$(Revision)' == ''">13</Revision>
    <PublishAotCrossVersionPrefix Condition="'$(PublishAotCrossVersionPrefix)' == ''">1.0.2</PublishAotCrossVersionPrefix>
    <PublishAotCrossVersion Condition="'$(PublishAotCrossVersion)' == ''">$(PublishAotCrossVersionPrefix).$(Revision)</PublishAotCrossVersion>
  </PropertyGroup>
</Project>
